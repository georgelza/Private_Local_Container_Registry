# ── CORE Banking .env ─────────────────────────────────────────────────────────
# Loaded by docker-compose.yml (project `corebanking`) and the Makefile. NEVER
# commit real secrets — this file is a template; values are overridden locally.

# Docker Compose project name — pinned to the SINGLE shared stack. All cores
# share this one Compose project (one Kafka, one PG cluster, one RustFS);
# per-core isolation comes from the coreN_ topic prefixes and per-core
# buckets/base_paths on the shared object store. `make createtopics` reads this
# (cre_topics.sh COMPOSE_PROJECT_NAME default).
COMPOSE_PROJECT_NAME=corebanking

# Default core selector for the Makefile (vcluster focus, per-core configs).
# Override per-invocation: CORE_ID=core2 make k8s-use
CORE_ID=core1
IMAGE_VER=0.6

# ── FIXED HOST PORTS ──────────────────────────────────────────────────────────
# No per-core port derivation — all cores share the same stack.
HOST_PORT_BROKER=9092            # PLAINTEXT_HOST listener (host tools / filebeat)
HOST_PORT_BROKER_K8S=29092       # PLAINTEXT listener (vcluster pods via ExternalName)
HOST_PORT_BROKER_JMX=9101        # Kafka JMX
HOST_PORT_SCHEMA_REGISTRY=9081
HOST_PORT_CONTROL_CENTER=9021
HOST_PORT_CONNECT=8083           # Kafka Connect REST API
HOST_PORT_RUSTFS=9000            # S3 API
HOST_PORT_PGBOUNCER=6432         # PG access (RW pool coreN_rw / RO pool coreN_ro)
# Local container registry (ADR-56; vcluster pulls via host.docker.internal:5001 — 5000 is held by macOS Control Center / AirPlay on this host)
HOST_PORT_REGISTRY=5001
# Registry web UI (joxit/docker-registry-ui:latest)
HOST_PORT_REGISTRY_UI=8080

REPO_NAME=georgelza

# Local container registry (ADR-56) — images are pushed to localhost:5001 and
# pulled by vcluster kubelets from host.docker.internal:5001.
REGISTRY_IMAGE=registry:2
REGISTRY_UI_IMAGE=joxit/docker-registry-ui:latest

# Kafka / Confluent
CONNECT_VERSION=3.4

# Kafka CLUSTER_ID (single-node KRaft) — generate with:
#   docker compose run --rm core_broker kafka-storage random-uuid
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# ── PostgreSQL / Citus ────────────────────────────────────────────────────────
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me
PG_ADMIN_USER=core_admin
PG_ADMIN_PASSWORD=change-me
PG_APP_USER=core_user
PG_APP_PASSWORD=change-me
PG_REPL_USER=replicator
PG_REPL_PASSWORD=change-me
PG_DB_NAME=postgres
# PgBouncer admin-console user (SHOW POOLS/CLIENTS/… via psql -U pgbouncer)
PGPOOL_ADMIN_PASSWORD=change-me

# ── REDIS (K8s only — compose stack does NOT run Redis; these are for CORE dev) ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=0
REDIS_SSL_CERT=
REDIS_SSL_KEY=
REDIS_SSL_CA=

# ── RustFS S3 object store (logging cold tier, docs/LOGGING.md) ──────────────
RUSTFS_ACCESS_KEY=rustfs
RUSTFS_SECRET_KEY=rustfs-secret
RUSTFS_IMAGE=rustfs/rustfs:latest

# S3 aliases consumed by the Elastic log-analytics scripts (scripts/*.sh) and the
# ES keystore secret (k8s/deploy/elastic/1.03.es-s3-credentials.yaml). These MUST
# mirror the RustFS root credentials above — keep them in sync.
S3_ACCESS_KEY_ID=rustfs
S3_SECRET_ACCESS_KEY=rustfs-secret
S3_REGION=af-south-1
S3_PROJECT_NAME=corebanking
# Per-class snapshot buckets (docs/LOGGING.md §2/§7): ops = short-retention
# dashboards/troubleshooting, txn = long-retention compliance/audit trail.
# The ES snapshot repositories keep the short class names (`ops`, `txn`).
S3_OPS_BUCKET=core-ops-archive
S3_TXN_BUCKET=core-txn-archive
S3_ENDPOINT=http://127.0.0.1:9000


# vCluster Platform
# Username: admin
# Password: 3fd886b6680edc14b8d3c2e840023a96ddcc625b4e0e4211ab5517c2fa0c34e3
# Login via UI:  https://bsez2c0.loft.host
# Login via CLI: vcluster platform login https://bsez2c0.loft.host

# ── Console bootstrap ─────────────────────────────────────────────────────────
# Consumed by cmd/console during the first-login flow. Local-only (gitignored).
# Never commit real credentials.
#
# There is NO username variable. The bootstrap identity is the fixed POSITION
# "admin" (lib/users.BootstrapPosition): it is a custodian, not a person, and is
# hidden from the operator user list. Its only job is to create the first
# protected Super-Admin; day-to-day administration is done by a named account.
#
# The position may log in once to set its password, after which the bootstrap
# password is invalidated and the credential is stored in Vault.
#
# NOTE: `make app` builds the console-bootstrap Secret from THIS key only, not
# from the whole file. Everything else above (PG superuser/app/repl passwords,
# REDIS_PASSWORD, RUSTFS/S3 secrets) is deliberately kept OUT of that Secret —
# the console pod mounts it as a file at /etc/core-bootstrap-auth.
CONSOLE_BOOTSTRAP_PW=ChangeMe#123456

# TEST_USER_PASSWORD is what testctl/testpack.sh sets on each MINTED operator,
# via POST /admin/v1/password/reset. It is deliberately NOT the bootstrap
# credential above: that one is minted into a k8s Secret at deploy time and the
# console loads it at boot, so the pack cannot change it. Sharing one value
# meant the pack authenticated the bootstrap position with the operator password,
# so changing an operator password locked the pack out with no way back in.
TEST_USER_PASSWORD=BankAdmin#2026Ops
