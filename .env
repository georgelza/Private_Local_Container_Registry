COMPOSE_PROJECT_NAME=regis

# ── The registry ─────────────────────────────────────────────────────────────
# Port is published to the host, so host-side tools (curl, docker push) reach
# it at localhost:<port>. The vCluster nodes dial the same port on the Docker
# gateway name instead — see REGISTRY_HOST in the Makefile.
#
# 5001 rather than 5000 because macOS Control Center / AirPlay holds 5000 on
# some hosts.
HOST_PORT_REGISTRY=5001
HOST_PORT_REGISTRY_UI=8080

REGISTRY_IMAGE=registry:2
REGISTRY_UI_IMAGE=joxit/docker-registry-ui:latest